		formatString: Long Date
		lineageTag: 862077b8-b6a3-4a7f-b9fd-17a292108e8a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column owner_clean =
			VAR o = Delivery[inventory_owner]
			VAR n = SWITCH(TRUE(), RIGHT(o, 5) = "_OPEN", 5, RIGHT(o, 7) = "_CLOSED", 7, RIGHT(o, 5) = "_TEMP", 5, 0)
			RETURN TRIM(LEFT(o, LEN(o) - n))
		dataType: string
		lineageTag: d928b70d-2edc-4430-ac70-6d603d006cda
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column is_in_scope = Delivery[computed_order_status] = "Open" && Delivery[order_date] >= DATE(2026, 1, 1)
		dataType: boolean
		lineageTag: b88d69ab-5a6e-4d14-8842-634a4b0569bf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column return_type =
			IF(NOT (Delivery[computed_order_status] = "Open"), BLANK(),
			    IF(LEFT(TRIM(Delivery[ship_to_no]), 5) = "80000", "Field Associate Return", "Consignment Return"))
		dataType: string
		lineageTag: 1932dbdd-2601-4fbc-b666-6940aa44166f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column return_order_qty
		dataType: double
		lineageTag: 1e776a89-f6d3-46f4-b74b-a6a2c39d76e4
		summarizeBy: sum
		sourceColumn: return_order_qty

		annotation SummarizationSetBy = Automatic

	column cls_blank3 = Delivery[computed_order_status] = "Open" && TRIM(COALESCE(Delivery[branch], "")) = "" && TRIM(COALESCE(Delivery[batch], "")) = "" && TRIM(COALESCE(Delivery[serial], "")) = ""
		dataType: boolean
		isHidden
		lineageTag: 4b6bf0b9-6fa3-4715-be9b-621ad9dbbc75
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column inv_pack =
			VAR isOpen = Delivery[computed_order_status] = "Open"
			RETURN
			    IF(NOT isOpen || Delivery[cls_blank3], BLANK(),
			        VAR rawS = TRIM(COALESCE(Delivery[sku], ""))
			        VAR rawB = TRIM(COALESCE(Delivery[batch], ""))
			        VAR rawC = TRIM(COALESCE(Delivery[ship_to_no], ""))
			        VAR qs = UPPER(IF(IFERROR(rawS = FORMAT(VALUE(rawS), REPT("0", LEN(rawS))), FALSE), FORMAT(VALUE(rawS), "0"), rawS))
			        VAR qb = UPPER(IF(IFERROR(rawB = FORMAT(VALUE(rawB), REPT("0", LEN(rawB))), FALSE), FORMAT(VALUE(rawB), "0"), rawB))
			        VAR qc = UPPER(IF(IFERROR(rawC = FORMAT(VALUE(rawC), REPT("0", LEN(rawC))), FALSE), FORMAT(VALUE(rawC), "0"), rawC))
			        VAR mv = COALESCE(Delivery[mv_status], "")
			        RETURN
			            IF(qs = "", "Unknown (Cockpit Unavailable)|Unknown",
			                VAR rowsSB = FILTER(Cockpit, Cockpit[ck_active] = TRUE() && Cockpit[ck_sku] = qs && Cockpit[ck_batch] = qb)
			                VAR hasEx = qc <> "" && COUNTROWS(FILTER(rowsSB, Cockpit[ck_cust] = qc)) > 0
			                VAR src = FILTER(rowsSB, NOT(hasEx) || Cockpit[ck_cust] = qc)
			                VAR found = COUNTROWS(src) > 0
			                VAR hasOther = NOT(hasEx) && COUNTROWS(FILTER(rowsSB, Cockpit[ck_cust] <> qc)) > 0
			                VAR onh = COALESCE(SUMX(src, Cockpit[qty_on_hand]), 0)
			                VAR inTr = COALESCE(SUMX(src, Cockpit[qty_in_transit]), 0)
			                VAR rst = COALESCE(SUMX(src, Cockpit[qty_restricted]), 0)
			                VAR tot = COALESCE(SUMX(src, Cockpit[qty_total]), 0)
			                VAR inv0 = IF(NOT(found), "Not in Inventory",
			                    IF(inTr > 0, "Unresolved Return Dispatch (In-Transit >0)",
			                    IF(onh > 0 || tot > 0, "Active in Inventory (On-Hand >0)",
			                    IF(rst > 0, "Restricted Only (Expiry Flag)", "Not in Inventory"))))
			                VAR fld0 = IF(NOT(found), "No Longer In Field",
			                    IF(inTr > 0, "In Transit (Return Not Received)",
			                    IF(onh > 0 || tot > 0, IF(hasOther, "Back In Field — Different Customer", "Still In Field — Original Customer"),
			                    IF(rst > 0, "No Longer In Field (Expiry-Restricted)", "No Longer In Field"))))
			                VAR fld1 = IF(Delivery[bu] = "DIV-B" && fld0 = "Back In Field — Different Customer", "No Longer In Field", fld0)
			                VAR residue = inv0 = "Unresolved Return Dispatch (In-Transit >0)" && (mv = "Inbounded" || mv = "Dropped-After-Inbound") && hasEx && inTr > 0 && onh <= 0 && rst <= 0 && tot <= 0
			                RETURN IF(residue, "Not in Inventory|No Longer In Field", inv0 & "|" & fld1)
			            )
			    )
		dataType: string
		isHidden
		lineageTag: 31df5db5-39a4-4a39-b566-29d3d7289d42
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column cls_inventory_status =
			IF(NOT (Delivery[computed_order_status] = "Open"), BLANK(),
			    IF(Delivery[cls_blank3], "Unknown (Cockpit Unavailable)", PATHITEM(Delivery[inv_pack], 1)))
		dataType: string
		lineageTag: 024a8587-2453-4618-bccc-2a12f4218e68
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column cls_field_status =
			IF(NOT (Delivery[computed_order_status] = "Open"), BLANK(),
			    IF(Delivery[cls_blank3], "Unknown", PATHITEM(Delivery[inv_pack], 2)))
		dataType: string
		lineageTag: 15575c44-4c60-477a-b689-68155c455637
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column rcpt_received =
			VAR ok = Delivery[computed_order_status] = "Open" && NOT(Delivery[cls_blank3]) && TRIM(COALESCE(Delivery[delivery_no], "")) <> "" && TRIM(COALESCE(Delivery[sku], "")) <> ""
			RETURN
			    IF(NOT ok, BLANK(),
			        VAR dn = Delivery[delivery_no]
			        VAR sk = Delivery[sku]
			        VAR bt = COALESCE(Delivery[batch], "")
			        RETURN COALESCE(SUMX(FILTER(Movement, Movement[movement_type] = "WHR" && Movement[reference] = dn && Movement[sku] = sk && COALESCE(Movement[batch], "") = bt), ABS(Movement[quantity])), 0)
			    )
		dataType: double
		formatString: 0.##
		lineageTag: 36f43536-632a-4fb4-a859-9ac7d031231f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column carrier_action =
			VAR so = TRIM(COALESCE(Delivery[sales_order], ""))
			RETURN
			    IF(NOT (Delivery[computed_order_status] = "Open") || Delivery[cls_blank3] || so = "", BLANK(),
			        VAR lat = FILTER(CarrierStatus, CarrierStatus[is_latest] = TRUE() && CarrierStatus[so_key] = so)
			        VAR nLab = COUNTROWS(lat)
			        RETURN IF(nLab = 0, "",
			            VAR st = ADDCOLUMNS(lat,
			                "isDel", SEARCH("DELIVERED", CarrierStatus[status_text], 1, 0) > 0,
			                "isShp", SEARCH("TRANSIT", CarrierStatus[status_text], 1, 0) > 0 || SEARCH("DELIVER", CarrierStatus[status_text], 1, 0) > 0 || SEARCH("PICKED UP", CarrierStatus[status_text], 1, 0) > 0 || SEARCH("SHIPPED", CarrierStatus[status_text], 1, 0) > 0 || SEARCH("OUT FOR DELIVERY", CarrierStatus[status_text], 1, 0) > 0 || SEARCH("AT DESTINATION", CarrierStatus[status_text], 1, 0) > 0,
			                "party", IF(TRIM(CarrierStatus[responsible_party]) = "" || UPPER(TRIM(CarrierStatus[responsible_party])) = "NAN", "",
			                    SWITCH(UPPER(TRIM(CarrierStatus[responsible_party])), "REP", "Rep", "CARRIER", "Carrier", "WAREHOUSE", "Warehouse", "CANCELLED", "Cancelled", "ERROR", "Error", TRIM(CarrierStatus[responsible_party]))))
			            VAR nDel = COUNTROWS(FILTER(st, [isDel]))
			            VAR nShp = COUNTROWS(FILTER(st, [isShp]))
			            VAR delDate = MAXX(FILTER(st, [isDel]), CarrierStatus[event_date])
			            VAR whText = "Follow up with Warehouse" & IF(ISBLANK(delDate), "", " (delivered " & FORMAT(delDate, "yyyy-MM-dd") & ")")
			            VAR parties = FILTER(DISTINCT(SELECTCOLUMNS(st, "p", [party])), [p] <> "")
			            VAR onlyP = MINX(parties, [p])
			            VAR direct = IF(COUNTROWS(parties) = 1, SWITCH(onlyP, "Rep", "Follow up with Rep", "Carrier", "Follow up with Carrier", "Warehouse", whText, ""), "")
			            RETURN IF(direct <> "", direct,
			                IF(nShp < nLab, "Follow up with Rep",
			                IF(nShp = nLab && nDel < nLab, "Follow up with Carrier",
			                IF(nDel >= nLab, whText, "Follow up with Rep"))))
			        )
			    )
		dataType: string
		lineageTag: 9afc2dcf-efaa-42c2-935c-c8b8b401482a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column cls_pack =
			IF(NOT (Delivery[computed_order_status] = "Open"), BLANK(),
			IF(Delivery[cls_blank3], "Inventory Review Return|HIGH: No Delivery on RMA - Inventory Review|0|No Confirmed Warehouse Receipt",
			    VAR mv = COALESCE(Delivery[mv_status], "")
			    VAR inv = Delivery[cls_inventory_status]
			    VAR fld = Delivery[cls_field_status]
			    VAR expQty = COALESCE(Delivery[return_order_qty], 0)
			    VAR rcv = COALESCE(Delivery[rcpt_received], 0)
			    VAR thr = [Aging Threshold Days]
			    VAR age = COALESCE(Delivery[aging_days], 0)
			    VAR ds = UPPER(TRIM(COALESCE(Delivery[so_overall_delivery_status], "")))
			    VAR ca = COALESCE(Delivery[carrier_action], "")
			    VAR conflict = TRIM(COALESCE(Delivery[carrier_conflict], "")) <> ""
			    VAR mvIn = mv = "Inbounded" || mv = "Dropped-After-Inbound"
			    VAR noLonger = fld = "No Longer In Field" || fld = "No Longer In Field (Expiry-Restricted)"
			    VAR partialHit = mvIn && expQty > 0 && rcv > 0 && rcv < expQty
			    VAR confirmed = mvIn && expQty > 0 && rcv >= expQty
			    VAR brUp = UPPER(TRIM(COALESCE(Delivery[branch], "")))
			    VAR isCons = brUp = "CON1" || brUp = "CON2" || SEARCH("CONSIGN", UPPER(COALESCE(Delivery[category], "")), 1, 0) > 0
			    VAR isRepPlant = brUp = "FLD3" || brUp = "FLD1" || brUp = "FLD2"
			    VAR lbl = COALESCE(Delivery[carrier_label_count], 0)
			    VAR crs = UPPER(COALESCE(Delivery[carrier_order_status], ""))
			    VAR shipped = SEARCH("TRANSIT", crs, 1, 0) > 0 || SEARCH("DELIVER", crs, 1, 0) > 0 || SEARCH("PICKED UP", crs, 1, 0) > 0 || SEARCH("SHIPPED", crs, 1, 0) > 0 || SEARCH("OUT FOR DELIVERY", crs, 1, 0) > 0 || SEARCH("AT DESTINATION", crs, 1, 0) > 0
			    VAR caWh = SEARCH("Warehouse", ca, 1, 0) > 0
			    VAR caCarrier = ca = "Follow up with Carrier"
			    VAR existingDrop = mv = "Dropped-Never-Inbounded" || mv = "Dropped-After-Inbound" || inv = "Unresolved Return Dispatch (In-Transit >0)"
			    VAR res =
			        IF(partialHit, "Inventory Review Return|HIGH: Partial Receipt by Warehouse — Inventory Review",
			        IF(confirmed && noLonger, "Inventory user to close the return|Inventory Closure Eligible: Full Warehouse Receipt Confirmed",
			        IF(confirmed, "Inventory Review Return|HIGH: Full Receipt by Warehouse - Reconcile Open Return",
			        IF(ds = "A" && isCons && shipped, "Inventory Review Return|HIGH: Consignment Shipment Shipped but Delivery Not Dropped",
			        IF(ds = "A" && isRepPlant && lbl > 0, "Inventory Review Return|HIGH: Carrier Label Exists but Delivery Not Dropped",
			        IF(ds = "A" && age > 30, "Inventory Review Return|HIGH: Delivery Not Dropped >30 Days - Inventory Review",
			        IF(ds <> "" && inv = "Active in Inventory (On-Hand >0)" && ca <> "",
			            IF(conflict && caWh && NOT(existingDrop), "Inventory Review Return|HIGH: Carrier Delivered but Delivery Not Dropped - Inventory Review", ca & "|Carrier: " & ca),
			        IF(mv = "Dropped-Never-Inbounded",
			            IF(caWh, "Follow up with Warehouse|CRITICAL: Return Dispatched — Carrier Confirmed Delivered, Warehouse to Process Inbound",
			            IF(caCarrier, "Follow up with Carrier|HIGH: Return Dispatched — Shipment In Transit, Follow Up with Carrier",
			            "Follow up with Rep|HIGH: Return Dispatched — Unit Still With Customer, Follow Up with Rep to Ship")),
			        IF(inv = "Unresolved Return Dispatch (In-Transit >0)",
			            IF(caWh, "Follow up with Warehouse|HIGH: Unresolved Return — Carrier Confirmed Delivered, Warehouse to Clear In-Transit",
			            IF(caCarrier, "Follow up with Carrier|HIGH: Unresolved Return — Shipment In Transit, Follow Up with Carrier",
			            "Follow up with Rep|HIGH: Unresolved Return — Unit Still With Customer or Not Yet Shipped")),
			        IF(conflict,
			            IF(existingDrop, "Follow up with Warehouse|HIGH: Carrier Delivered - Warehouse to Inbound Return (Dispatch Pending)", "Inventory Review Return|HIGH: Carrier Delivered but Delivery Not Dropped - Inventory Review"),
			        IF(fld = "Back In Field — Different Customer", "Inventory Review Return|HIGH: Unit Back In Field Under Different Customer — Inventory Review",
			        IF(fld = "Still In Field — Original Customer", "Follow up with Rep|MEDIUM: Unit Still In Field With Original Customer",
			        IF(mvIn && noLonger, "Inventory user to close the return|Inventory Closure Eligible: Inbounded and No Longer In Field",
			        IF(mv = "No Movement" && age > thr, "Follow up with Rep|MEDIUM: No Warehouse Movement, Aged >" & thr & "d",
			        IF(fld = "Unknown" || inv = "Unknown (Cockpit Unavailable)", "Follow up with Rep|MEDIUM: Unknown Inventory State — Verify Manually",
			        "Follow up with Rep|MEDIUM: Open Return — Verify With Rep")))))))))))))))
			    VAR recStatus = IF(partialHit, "Partial Warehouse Receipt", IF(confirmed, "Warehouse Receipt Confirmed", "No Confirmed Warehouse Receipt"))
			    VAR recQty = IF(partialHit || confirmed, rcv, 0)
			    RETURN res & "|" & recQty & "|" & recStatus
			))
		dataType: string
		isHidden
		lineageTag: 5f3d6bc4-9afd-4852-91fe-ff217548db0b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column recommended_action = IF(ISBLANK(Delivery[cls_pack]), BLANK(), PATHITEM(Delivery[cls_pack], 1))
		dataType: string
		lineageTag: a3dbcb4f-d533-4984-bb09-75045ae723a0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column issue_name = IF(ISBLANK(Delivery[cls_pack]), BLANK(), PATHITEM(Delivery[cls_pack], 2))
		dataType: string
		lineageTag: ee602da4-f119-4e49-a2dc-12e4d21fc5f5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column receipt_evidence_qty = IF(ISBLANK(Delivery[cls_pack]), BLANK(), VALUE(PATHITEM(Delivery[cls_pack], 3)))
		dataType: double
		formatString: 0.##
		lineageTag: daad1360-980b-4a1c-846f-3429d2c9fd9e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column receipt_evidence_status = IF(ISBLANK(Delivery[cls_pack]), BLANK(), PATHITEM(Delivery[cls_pack], 4))
		dataType: string
		lineageTag: a01eb31a-0b73-4ce8-a786-df13f8d41b14
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column action_owner =
			VAR a = Delivery[recommended_action]
			RETURN
			    IF(ISBLANK(a), BLANK(),
			    IF(LEFT(a, LEN("Inventory Review Return")) = "Inventory Review Return", "Inventory",
			    IF(LEFT(a, LEN("Inventory user to close the return")) = "Inventory user to close the return", "Inventory",
			    IF(LEFT(a, LEN("Follow up with Warehouse")) = "Follow up with Warehouse", "Warehouse",
			    IF(LEFT(a, LEN("Follow up with Carrier")) = "Follow up with Carrier", "Carrier",
			    IF(LEFT(a, LEN("Follow up with Rep")) = "Follow up with Rep", "Rep", ""))))))
		dataType: string
		lineageTag: 367a5bdf-e755-4f2f-b52e-dc9fc9429311
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column action_type =
			VAR o = Delivery[action_owner]
			VAR a = Delivery[recommended_action]
			RETURN
			    IF(ISBLANK(o), BLANK(),
			    IF(o = "Inventory", IF(LEFT(a, LEN("Inventory Review Return")) = "Inventory Review Return", "Review", "Close"),
			    IF(o = "Warehouse", "Inbound",
			    IF(o = "Carrier", "Investigate",
			    IF(o = "Rep", "Follow-up", "")))))
		dataType: string
		lineageTag: d15b2e96-8211-4f26-a4fb-9b8f6a76b8f8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column action_priority =
			VAR o = Delivery[action_owner]
			VAR a = Delivery[recommended_action]
			RETURN
			    IF(ISBLANK(o), BLANK(),
			    IF(o = "Inventory", IF(LEFT(a, LEN("Inventory Review Return")) = "Inventory Review Return", "High", "Normal"), ""))
		dataType: string
		lineageTag: 1af07476-454b-4faf-ad34-9b4d18ea4cd4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column exception_issue =
			IF(NOT (Delivery[computed_order_status] = "Open") || Delivery[action_owner] = "Inventory", BLANK(),
			    VAR thr = [Aging Threshold Days]
			    VAR age = COALESCE(Delivery[aging_days], 0)
			    VAR mv = COALESCE(Delivery[mv_status], "")
			    VAR crs = UPPER(COALESCE(Delivery[carrier_order_status], ""))
			    VAR delivered = SEARCH("DELIVERED", crs, 1, 0) > 0
			    VAR inTransit = SEARCH("TRANSIT", crs, 1, 0) > 0 || SEARCH("PICKED UP", crs, 1, 0) > 0 || SEARCH("SHIPPED", crs, 1, 0) > 0 || SEARCH("OUT FOR DELIVERY", crs, 1, 0) > 0 || SEARCH("AT DESTINATION", crs, 1, 0) > 0 || SEARCH("AT CARRIER", crs, 1, 0) > 0 || SEARCH("ARRIVED", crs, 1, 0) > 0
			    VAR lost = age > thr && Delivery[recommended_action] = "Follow up with Carrier" && inTransit && NOT(delivered)
			    VAR sev = IF(Delivery[action_owner] = "Warehouse", "CRITICAL", "HIGH")
			    VAR conflict = TRIM(COALESCE(Delivery[carrier_conflict], "")) <> ""
			    RETURN
			        IF(lost, "HIGH: Shipment Lost in Transit (>" & thr & "d, no Carrier delivery)",
			        IF(mv = "Dropped-Never-Inbounded", sev & ": Return Never Received at Warehouse",
			        IF(mv = "Dropped-After-Inbound", sev & ": Return Dropped After Inbound",
			        IF(mv = "No Movement" && age > thr, "MEDIUM: Return No Warehouse Movement",
			        IF(conflict, sev & ": Return Carrier Delivered but Open in System", BLANK())))))
			)
		dataType: string
		lineageTag: 20f9aed2-ddc5-4598-9ef2-7fad18a8e123
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column exception_severity =
			VAR i = Delivery[exception_issue]
			RETURN
			    IF(ISBLANK(i), BLANK(),
			    IF(LEFT(i, 8) = "CRITICAL", "CRITICAL",
			    IF(LEFT(i, 4) = "HIGH", "HIGH",
			    IF(LEFT(i, 6) = "MEDIUM", "MEDIUM", ""))))
		dataType: string
		lineageTag: fbf6f0d0-c8c1-43f9-b408-fe5b7ab4d185
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column exception_priority =
			IF(ISBLANK(Delivery[exception_issue]), BLANK(),
			    VAR thr = [Aging Threshold Days]
			    VAR age = COALESCE(Delivery[aging_days], 0)
			    VAR mv = COALESCE(Delivery[mv_status], "")
			    VAR hasTr = NOT(ISBLANK(Delivery[tracking])) && TRIM(Delivery[tracking]) <> ""
			    VAR agePts = IF(age > 45, IF(hasTr, 70, 90), IF(age > thr, IF(hasTr, 60, 80), 0))
			    VAR mvPts = IF(mv = "Dropped-Never-Inbounded", 95, IF(mv = "Dropped-After-Inbound", 75, 0))
			    VAR cfPts = IF(TRIM(COALESCE(Delivery[carrier_conflict], "")) <> "", 70, 0)
			    RETURN MIN(agePts + mvPts + cfPts, 200)
			)
		dataType: int64
		formatString: 0
		lineageTag: 227ae861-43ab-40c9-a3bb-602ff7286f8f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column nodel_case =
			VAR i = Delivery[issue_name]
			RETURN
			    IF(ISBLANK(i) || SEARCH("No Delivery on RMA", i, 1, 0) = 0, BLANK(),
			        VAR hasTr = NOT(ISBLANK(Delivery[tracking])) && TRIM(Delivery[tracking]) <> ""
			        VAR crs = UPPER(COALESCE(Delivery[carrier_status], ""))
			        VAR delivered = SEARCH("DELIVER", crs, 1, 0) > 0
			        VAR moving = SEARCH("TRANSIT", crs, 1, 0) > 0 || SEARCH("PICKED UP", crs, 1, 0) > 0 || SEARCH("SHIPPED", crs, 1, 0) > 0 || SEARCH("OUT FOR DELIVERY", crs, 1, 0) > 0 || SEARCH("AT DESTINATION", crs, 1, 0) > 0 || SEARCH("AT CARRIER", crs, 1, 0) > 0 || SEARCH("ARRIVED", crs, 1, 0) > 0
			        RETURN
			            IF(NOT(hasTr), "NOTRACK",
			            IF(delivered, "DELIVERED",
			            IF(moving, "MOVING",
			            IF(Delivery[return_type] = "Field Associate Return", "LABEL_FAR", "LABEL_CONS"))))
			    )
		dataType: string
		isHidden
		lineageTag: 30c19df0-7b1c-404a-997d-8cb7e24b561b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column action_group =
			VAR i = Delivery[issue_name]
			VAR o = Delivery[action_owner]
			VAR a = Delivery[recommended_action]
				VAR c = Delivery[nodel_case]
			RETURN
			    IF(ISBLANK(i), BLANK(),
			    IF(o = "Inventory",
			        IF(SEARCH("No Delivery on RMA", i, 1, 0) > 0, IF(c = "NOTRACK", "2 Create delivery / send label", IF(c = "LABEL_CONS", "4 Chase the Rep", "1 Drop the delivery")),
			        IF(SEARCH("Delivery Not Dropped", i, 1, 0) > 0, "1 Drop the delivery",
			        IF(LEFT(a, LEN("Inventory user to close the return")) = "Inventory user to close the return", "7 Close the return",
			        "3 Review and reconcile"))),
			    IF(o = "Rep", "4 Chase the Rep",
			    IF(o = "Carrier", "5 Chase Carrier",
			    IF(o = "Warehouse", "6 Chase the Warehouse", "3 Review and reconcile")))))
		dataType: string
		lineageTag: 2a462e0b-65fd-4694-bd35-2bfb0f222aad
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column next_step =
			VAR i = Delivery[issue_name]
			VAR o = Delivery[action_owner]
			VAR rt = Delivery[return_type]
				VAR c = Delivery[nodel_case]
			VAR expQty = FORMAT(COALESCE(Delivery[return_order_qty], 0), "General Number")
			VAR rcvQty = FORMAT(COALESCE(Delivery[receipt_evidence_qty], 0), "General Number")
			RETURN
			    IF(ISBLANK(i), BLANK(),
			    SWITCH(TRUE(),
			        SEARCH("No Delivery on RMA", i, 1, 0) > 0,
			            SWITCH(c, "NOTRACK", IF(rt = "Field Associate Return",
			                "Create the RMA copy and give the field associate the Carrier label. Drop the delivery when the label is provided.",
			                "Create the RMA copy and give the customer the Carrier label. Drop the delivery once the label shows Carrier movement."),
				                "DELIVERED", "Carrier shows the package delivered but no delivery exists, so the warehouse cannot inbound it. Drop the delivery now.",
				                "MOVING", "Carrier shows the package moving. Drop the delivery now.",
				                "LABEL_FAR", "The Carrier label has been provided (tracking number on the return). Drop the delivery now.",
				                "A Carrier label exists but Carrier shows no movement yet. Follow up with the Rep to get the unit shipped; drop the delivery once it moves."),
			        SEARCH("Consignment Shipment Shipped", i, 1, 0) > 0,
			            "Carrier shows the consignment shipment moving but no delivery has been dropped. Drop the delivery in ERP.",
			        SEARCH("Label Exists but Delivery Not Dropped", i, 1, 0) > 0,
			            "A Carrier label already exists but no delivery has been dropped. Drop the delivery in ERP.",
			        SEARCH("Not Dropped >30", i, 1, 0) > 0,
			            "No delivery has been dropped after more than 30 days. Check with the field, then drop the delivery or close the return.",
			        SEARCH("Delivered but Delivery Not Dropped", i, 1, 0) > 0,
			            "Carrier shows the package delivered but no delivery was dropped. Drop the delivery so the warehouse can inbound it.",
			        SEARCH("Partial Receipt", i, 1, 0) > 0,
			            "The warehouse received only part of the quantity (" & rcvQty & " of " & expQty & "). Confirm with the warehouse, then reconcile or close the return.",
			        SEARCH("Receipt by Warehouse - Reconcile", i, 1, 0) > 0 || SEARCH("Warehouse Receipt Confirmed - Reconcile", i, 1, 0) > 0,
			            "The warehouse has received the full quantity but the return is still open and the unit still shows in the field. Reconcile with the warehouse, then close the return.",
			        SEARCH("Possible Warehouse Receipt", i, 1, 0) > 0,
			            "A warehouse receipt may match this return. Validate the match in ERP.",
			        SEARCH("Different Customer", i, 1, 0) > 0,
			            "The unit shows in field stock under a different customer. Verify the location in ERP before closing.",
			        SEARCH("Closure Eligible", i, 1, 0) > 0,
			            "The warehouse has received the unit and it is no longer in the field. Close the return in ERP, or note why it is blocked.",
			        o = "Warehouse",
			            "Carrier shows the package delivered. Ask the warehouse to process the inbound and clear the in-transit stock.",
			        o = "Carrier",
			            "The package is with Carrier and not yet delivered. Follow up with Carrier on the delivery.",
			        SEARCH("Still In Field With Original", i, 1, 0) > 0,
			            "The unit is still in the field with the original customer. Follow up with the Rep to return it.",
			        SEARCH("No Warehouse Movement", i, 1, 0) > 0,
			            "There is no warehouse movement yet. Follow up with the Rep to ship the unit.",
			        SEARCH("Unknown Inventory", i, 1, 0) > 0,
			            "The inventory state is unknown. Verify the return manually in ERP.",
			        SEARCH("Verify With Rep", i, 1, 0) > 0,
			            "Verify this return with the Rep.",
			        o = "Rep",
			            "The unit is still with the customer or not shipped yet. Follow up with the Rep to ship it.",
			        "Follow up with " & o & ": " & i))
		dataType: string
		lineageTag: d8576a4f-4ffb-4093-a765-0ceb622b3f17
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column work_order =
			IF(ISBLANK(Delivery[action_group]), BLANK(),
			    VALUE(LEFT(Delivery[action_group], 1)) * 100000 + (99999 - MIN(COALESCE(Delivery[aging_days], 0), 99999)))
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f1897086-2e59-4a4e-adec-df7f7c471e23
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column days_to_delivery =
			VAR od = Delivery[order_date]
			VAR dd = Delivery[date]
			RETURN
			    IF(ISBLANK(od) || od <= DATE(1900, 1, 2), BLANK(),
			    IF(dd > DATE(1900, 1, 2), IF(dd >= od, DATEDIFF(od, dd, DAY), 0),
			    IF(Delivery[computed_order_status] = "Open", IF(TODAY() >= od, DATEDIFF(od, TODAY(), DAY), 0), BLANK())))
		dataType: int64
		formatString: 0
		lineageTag: 782c38da-1b2e-4759-b9bc-46fc73017cbe
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column line_outcome =
			IF(Delivery[date] > DATE(1900, 1, 2),
			    IF(Delivery[days_to_delivery] <= [Aging Threshold Days], "On time", "Late"),
			    IF(Delivery[computed_order_status] = "Open", "Waiting", "Closed without delivery"))
		dataType: string
		lineageTag: b41750d8-71cf-4993-87f9-3eb2f73e968d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column order_reason
		dataType: string
		lineageTag: 4e2a9c71-8d36-4b05-a1f7-0c5b3e6d8a92
		summarizeBy: none
		sourceColumn: order_reason

		annotation SummarizationSetBy = Automatic

	column product_class
		dataType: string
		lineageTag: 6c1d8e42-3b7a-4f0e-9a55-2e8f1b7c4d10
		summarizeBy: none
		sourceColumn: product_class

		annotation SummarizationSetBy = Automatic

	column product_group
		dataType: string
		lineageTag: b93a7f16-5d2c-4e81-8c04-7a1e6d3f9b27
		summarizeBy: none
		sourceColumn: product_group

		annotation SummarizationSetBy = Automatic

	column return_reason =
			VAR c = UPPER(TRIM(COALESCE(Delivery[order_reason], "")))
			RETURN
			    SWITCH(c,
			        "", "No reason recorded",
			        "F01", "Return Inventory Removal",
			        "F02", "Return Loaner",
			        "F03", "Return Temp Increase",
			        "F04", "Return Consign Close",
			        "F05", "Return Consign Removal",
			        "F06", "Return Damaged",
			        "F07", "Return Expired",
			        "F08", "Return Exiting Employee",
			        "F09", "Return Overstocked",
			        "F10", "Return Ship Error",
			        "F11", "Return Study Complete",
			        "F12", "Return Short Dated",
			        "F13", "Return Recall",
			        "R14", "Return Consignment Error",
			        "R26", "Return Customer No Longer Uses/Needs",
			        "Reason code " & c)
		dataType: string
		lineageTag: c3e81f5a-6b92-47d0-9a14-5d7e2b0f8c36
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column receipt_status =
			VAR dn = TRIM(COALESCE(Delivery[delivery_no], ""))
			VAR sk = Delivery[sku]
			RETURN
			    IF(Delivery[order_status] = "Not Closed" && UPPER(TRIM(COALESCE(Delivery[so_overall_delivery_status], ""))) = "C" && dn <> "",
			        IF(CALCULATE(COUNTROWS(Movement), Movement[movement_type] = "WHR", Movement[reference] = dn, Movement[sku] = sk) > 0, "Received at DC", "Pending DC receipt"),
			        BLANK())
		dataType: string
		lineageTag: 7a5c1e93-2f48-4d6b-b0a3-9e8d4c2f1b65
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Delivery = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(File.Contents(DataFolder & "delivery.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Renamed Columns" = Table.TransformColumnTypes(Promoted, {{"order_status", type text}, {"so_overall_delivery_status", type text}, {"sales_organization", type text}, {"branch", type text}, {"product_division", type text}, {"po_type_desc", type text}, {"sales_order", type text}, {"sales_order_type_desc", type text}, {"order_reason", type text}, {"delivery_no", type text}, {"batch", type text}, {"serial", type text}, {"po_no", type text}, {"shipping_plant", type text}, {"ship_to_no", type text}, {"ship_to", type text}, {"sold_to", type text}, {"sku", type text}, {"description", type text}, {"product_class", type text}, {"product_group", type text}, {"area_a", type text}, {"area_b", type text}, {"region_a", type text}, {"region_b", type text}, {"territory_a", type text}, {"territory_b", type text}, {"tracking", type text}, {"region_id", type text}, {"territory_id", type text}, {"date", type date}, {"order_date", type date}, {"expiry", type date}, {"so_line", type number}, {"delivery_line", type number}, {"return_order_qty", type number}}),
				    #"Typed Expiry" = Table.TransformColumnTypes(#"Renamed Columns", {{"expiry", type date}, {"return_order_qty", type number}}),
				
				    #"Added Order Status" = Table.AddColumn(#"Typed Expiry", "computed_order_status", each
				        let
				            rawA = Text.Trim(Text.Upper(Text.From([order_status] ?? ""))),
				            statusC = Text.Trim(Text.Upper(Text.From([so_overall_delivery_status] ?? ""))),
				            isNotClosedA = rawA = "NOT CLOSED",
				            isOpenC = List.Contains({"A","B",""}, statusC),
				            isOpen = isNotClosedA and isOpenC
				        in
				            if isOpen then "Open" else "Closed",
				        type text),
				
				    #"Added Plant Code" = Table.AddColumn(#"Added Order Status", "plant_code", each
				        if [branch] = null then null else Text.Trim(Text.Upper(Text.BeforeDelimiter([branch], "_"))),
				        type text),
				
				    #"Filtered Scope" = Table.SelectRows(#"Added Plant Code", each
				        (List.Contains({"FLD1","FLD2","CON1","FLD3","CON2"}, [plant_code]) or [branch] = null or Text.Trim(Text.From([branch])) = "")
				        and List.Contains({"A","B","C",""}, Text.Trim(Text.Upper(Text.From([so_overall_delivery_status] ?? ""))))
				    ),
				
				    #"Deduped" = Table.Distinct(#"Filtered Scope", {"sales_order","so_line","delivery_no","delivery_line","sku","batch","serial"}),
				
				    PlantClassTable = #table(
				        {"plant_code","plant_bu","plant_category"},
				        {
				            {"FLD1","DIV-A","Field Associate Returns"},
				            {"FLD2","DIV-A","Field Associate Returns"},
				            {"CON1","DIV-A","Consignment"},
				            {"FLD3","DIV-B","Field Associate Returns"},
				            {"CON2","DIV-B","Consignment"}
				        }
				    ),
				    #"Merged Plant Class" = Table.NestedJoin(#"Deduped", {"plant_code"}, PlantClassTable, {"plant_code"}, "PlantClass", JoinKind.LeftOuter),
				    #"Expanded Plant Class" = Table.ExpandTableColumn(#"Merged Plant Class", "PlantClass", {"plant_bu","plant_category"}, {"plant_bu","plant_category"}),
				
				    #"Added BU List" = Table.AddColumn(#"Expanded Plant Class", "bu_list", each
				        if [plant_bu] <> null then {[plant_bu]}
				        else if List.Contains({"20","30"}, [product_division]) then {"DIV-A"}
				        else if [product_division] = "10" then {"DIV-B"}
				        else {"DIV-A","DIV-B"},
				        type list),
				    #"Added Routing Status" = Table.AddColumn(#"Added BU List", "bu_routing_status", each
				        if [plant_bu] <> null then "classified"
				        else if List.Contains({"20","30","10"}, [product_division]) then "product_division_fallback"
				        else "unresolved_product_division",
				        type text),
				    #"Expanded BU" = Table.ExpandListColumn(#"Added Routing Status", "bu_list"),
				    #"Renamed BU" = Table.RemoveColumns(Table.RenameColumns(#"Expanded BU", {{"bu_list","bu"}}), {"plant_bu"}),
				    #"Filled Category" = Table.ReplaceValue(#"Renamed BU", null, "Other", Replacer.ReplaceValue, {"plant_category"}),
				    #"Renamed Category" = Table.RenameColumns(#"Filled Category", {{"plant_category","category"}}),
				
				    CockpitClean = Table.SelectRows(Cockpit, each [expiry] <> null and [expiry] >= #date(1901,1,1)),
				    Lvl2 = Table.RenameColumns(
				        Table.SelectColumns(
				            Table.Distinct(Table.SelectRows(CockpitClean, each [sku] <> null and [serial] <> null), {"sku","serial"}),
				            {"sku","serial","expiry"}),
				        {"expiry","expiry_lvl2"}),
				    Lvl3 = Table.RenameColumns(
				        Table.SelectColumns(
				            Table.Distinct(Table.SelectRows(CockpitClean, each [sku] <> null and [batch] <> null), {"sku","batch"}),
				            {"sku","batch","expiry"}),
				        {"expiry","expiry_lvl3"}),
				    BatchGrouped = Table.Group(Table.SelectRows(CockpitClean, each [batch] <> null), {"batch"}, {
				        {"DistinctSkuCount", each List.Count(List.Distinct([sku])), Int64.Type},
				        {"expiry_lvl4", each List.First([expiry]), type nullable date}
				    }),
				    Lvl4 = Table.SelectColumns(Table.SelectRows(BatchGrouped, each [DistinctSkuCount] = 1), {"batch","expiry_lvl4"}),
				    SerialGrouped = Table.Group(Table.SelectRows(CockpitClean, each [serial] <> null), {"serial"}, {
				        {"DistinctSkuCount", each List.Count(List.Distinct([sku])), Int64.Type},
				        {"expiry_lvl5", each List.First([expiry]), type nullable date}
				    }),
				    Lvl5 = Table.SelectColumns(Table.SelectRows(SerialGrouped, each [DistinctSkuCount] = 1), {"serial","expiry_lvl5"}),
				
				    #"Merged Lvl2" = Table.NestedJoin(#"Renamed Category", {"sku","serial"}, Lvl2, {"sku","serial"}, "Lvl2Match", JoinKind.LeftOuter),
				    #"Expanded Lvl2" = Table.ExpandTableColumn(#"Merged Lvl2", "Lvl2Match", {"expiry_lvl2"}, {"expiry_lvl2"}),
				    #"Merged Lvl3" = Table.NestedJoin(#"Expanded Lvl2", {"sku","batch"}, Lvl3, {"sku","batch"}, "Lvl3Match", JoinKind.LeftOuter),
				    #"Expanded Lvl3" = Table.ExpandTableColumn(#"Merged Lvl3", "Lvl3Match", {"expiry_lvl3"}, {"expiry_lvl3"}),
				    #"Merged Lvl4" = Table.NestedJoin(#"Expanded Lvl3", {"batch"}, Lvl4, {"batch"}, "Lvl4Match", JoinKind.LeftOuter),
				    #"Expanded Lvl4" = Table.ExpandTableColumn(#"Merged Lvl4", "Lvl4Match", {"expiry_lvl4"}, {"expiry_lvl4"}),
				    #"Merged Lvl5" = Table.NestedJoin(#"Expanded Lvl4", {"serial"}, Lvl5, {"serial"}, "Lvl5Match", JoinKind.LeftOuter),
				    #"Expanded Lvl5" = Table.ExpandTableColumn(#"Merged Lvl5", "Lvl5Match", {"expiry_lvl5"}, {"expiry_lvl5"}),
				
				    #"Added Resolved Expiry" = Table.AddColumn(#"Expanded Lvl5", "resolved_expiry", each
				        if [expiry] <> null and [expiry] >= #date(1901,1,1) then [expiry]
				        else if [expiry_lvl2] <> null then [expiry_lvl2]
				        else if [expiry_lvl3] <> null then [expiry_lvl3]
				        else if [expiry_lvl4] <> null then [expiry_lvl4]
				        else if [expiry_lvl5] <> null then [expiry_lvl5]
				        else null,
				        type nullable date),
				    #"Removed Helper Cols" = Table.RemoveColumns(#"Added Resolved Expiry", {"expiry_lvl2","expiry_lvl3","expiry_lvl4","expiry_lvl5"})
				in
				    #"Removed Helper Cols"
