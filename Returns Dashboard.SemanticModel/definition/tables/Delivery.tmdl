	column mv_match_basis =
			VAR p = Delivery[mv_pick]
			VAR b = IF(ISBLANK(p), "", PATHITEM(p, 1))
			RETURN IF(b = "" || b = "none", BLANK(), b)
		dataType: string
		lineageTag: 066e4779-620c-460a-9e7c-20d246906d4e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column mv_validation_key =
			VAR isOpen = Delivery[computed_order_status] = "Open"
			VAR dn = Delivery[delivery_no]
			VAR sk = Delivery[sku]
			VAR so = Delivery[sales_order]
			VAR hasDn = NOT ISBLANK(dn) && dn <> "" && NOT ISBLANK(sk) && sk <> ""
			VAR hasSo = NOT ISBLANK(so) && so <> "" && NOT ISBLANK(sk) && sk <> ""
			RETURN
			    IF(NOT isOpen, BLANK(),
			    IF(NOT hasDn && NOT hasSo, "",
			        VAR rawD = TRIM(dn)
			        VAR rawO = TRIM(so)
			        VAR rawS = TRIM(sk)
			        VAR rawB = TRIM(COALESCE(Delivery[batch], ""))
			        VAR nD = IF(IFERROR(rawD = FORMAT(VALUE(rawD), REPT("0", LEN(rawD))), FALSE), FORMAT(VALUE(rawD), "0"), rawD)
			        VAR nO = IF(IFERROR(rawO = FORMAT(VALUE(rawO), REPT("0", LEN(rawO))), FALSE), FORMAT(VALUE(rawO), "0"), rawO)
			        VAR nS = IF(IFERROR(rawS = FORMAT(VALUE(rawS), REPT("0", LEN(rawS))), FALSE), FORMAT(VALUE(rawS), "0"), rawS)
			        VAR nB = IF(IFERROR(rawB = FORMAT(VALUE(rawB), REPT("0", LEN(rawB))), FALSE), FORMAT(VALUE(rawB), "0"), rawB)
			        RETURN IF(hasDn, nD & "|" & nS & "|" & nB, "SO:" & nO & "|" & nS & "|" & nB)
			    ))
		dataType: string
		lineageTag: 8959d16c-85a2-4289-bc18-fd6aa22261b3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column mv_status =
			VAR isOpen = Delivery[computed_order_status] = "Open"
			VAR t = Delivery[mv_type]
			RETURN
			    IF(NOT isOpen, BLANK(),
			    IF(ISBLANK(t), "No Movement",
			    IF(t = "WHR", "Inbounded",
			        VAR dn = Delivery[delivery_no]
			        VAR sk = Delivery[sku]
			        VAR bt = Delivery[batch]
			        VAR hasBatch = NOT ISBLANK(bt) && bt <> ""
			        VAR hasWhr = IF(hasBatch, COUNTROWS(FILTER(Movement, Movement[reference] = dn && Movement[sku] = sk && Movement[batch] = bt && Movement[movement_type] = "WHR")) > 0, COUNTROWS(FILTER(Movement, Movement[reference] = dn && Movement[sku] = sk && Movement[movement_type] = "WHR")) > 0)
			        RETURN IF(hasWhr, "Dropped-After-Inbound", "Dropped-Never-Inbounded")
			    )))
		dataType: string
		lineageTag: 54f74b1e-0fe2-4040-bd8f-54e71faa3901
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column carrier_status =
			VAR isOpen = Delivery[computed_order_status] = "Open"
			VAR raw = Delivery[tracking]
			RETURN
			    IF(NOT isOpen, BLANK(),
			    IF(ISBLANK(raw) || TRIM(raw) = "", "",
			        VAR s0 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(raw, ",", " "), ";", " "), "/", " "), "|", " "), "-", " "), UNICHAR(9), " "), UNICHAR(10), " "), UNICHAR(13), " ")
			        VAR pth = SUBSTITUTE(TRIM(s0), " ", "|")
			        VAR ids = ADDCOLUMNS(GENERATESERIES(1, PATHLENGTH(pth)), "id", PATHITEM(pth, [Value]))
			        VAR sts = ADDCOLUMNS(ids, "st", LOOKUPVALUE(CarrierStatus[status_text], CarrierStatus[latest_key], [id]))
			        RETURN COALESCE(CONCATENATEX(FILTER(DISTINCT(SELECTCOLUMNS(sts, "s", [st])), NOT ISBLANK([s]) && [s] <> ""), [s], ", ", [s], ASC), "")
			    ))
		dataType: string
		lineageTag: 33bb902a-5355-4307-b27d-baaea23048d4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column carrier_label_count =
			VAR isOpen = Delivery[computed_order_status] = "Open"
			VAR so = TRIM(Delivery[sales_order])
			RETURN
			    IF(NOT isOpen, BLANK(),
			    IF(so = "", 0,
			        COUNTROWS(FILTER(CarrierStatus, CarrierStatus[is_latest] = TRUE() && CarrierStatus[so_key] = so))
			    ))
		dataType: int64
		formatString: 0
		lineageTag: 78b7fd5e-6e9d-49b1-b4a7-7c3eacc3a2ce
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column carrier_order_status =
			VAR isOpen = Delivery[computed_order_status] = "Open"
			VAR so = TRIM(Delivery[sales_order])
			RETURN
			    IF(NOT isOpen, BLANK(),
			    IF(so = "", "",
			        COALESCE(CONCATENATEX(FILTER(DISTINCT(SELECTCOLUMNS(FILTER(CarrierStatus, CarrierStatus[is_latest] = TRUE() && CarrierStatus[so_key] = so), "s", CarrierStatus[status_text])), NOT ISBLANK([s]) && [s] <> ""), [s], ", ", [s], ASC), "")
			    ))
		dataType: string
		lineageTag: f1cfc71c-3e28-4beb-8bf7-8809b13574d0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column carrier_conflict =
			VAR isOpen = Delivery[computed_order_status] = "Open"
			RETURN
			    IF(NOT isOpen, BLANK(),
			    IF(SEARCH("DELIVER", Delivery[carrier_status], 1, 0) > 0, "CONFLICT: Carrier DELIVERED but record still open — verify receipt", ""))
		dataType: string
		lineageTag: ac9768cd-0a9b-4bbd-b033-b18899d0373c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column aging_date =
			IF(NOT (Delivery[computed_order_status] = "Open"), BLANK(),
			    IF(Delivery[order_date] > DATE(1900, 1, 2), Delivery[order_date],
			    IF(Delivery[date] > DATE(1900, 1, 2), Delivery[date], BLANK())))
		dataType: dateTime
		formatString: Long Date
		lineageTag: 02dd39c8-87a1-471d-a802-da582e134807
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column aging_days =
			IF(NOT (Delivery[computed_order_status] = "Open"), BLANK(),
			    IF(ISBLANK(Delivery[aging_date]), 0, DATEDIFF(Delivery[aging_date], TODAY(), DAY)))
		dataType: int64
		formatString: 0
		lineageTag: e6b254e3-7d8a-4e50-8db2-3a066d939c3d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column aging_bucket_order =
			VAR d = Delivery[aging_days]
			RETURN IF(ISBLANK(d), BLANK(), SWITCH(TRUE(), d <= 7, 1, d <= 14, 2, d <= 30, 3, d <= 45, 4, 5))
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 023c0f3b-5da8-4620-a7b3-c807cfb05695
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column aging_bucket = SWITCH(Delivery[aging_bucket_order], 1, "0-7 (Healthy)", 2, "8-14 (Watch)", 3, "15-30 (Follow-up)", 4, "31-45 (Escalation)", 5, "46+ (Management visibility)", BLANK())
		dataType: string
		lineageTag: ba5e003f-14e6-4532-afbd-e2c9f5a42319
		summarizeBy: none
		sortByColumn: aging_bucket_order

		annotation SummarizationSetBy = Automatic

	column expiry_days =
			VAR e = IF(Delivery[resolved_expiry] > DATE(1900, 1, 2), Delivery[resolved_expiry], BLANK())
			RETURN IF(NOT (Delivery[computed_order_status] = "Open") || ISBLANK(e), BLANK(), DATEDIFF(TODAY(), e, DAY))
		dataType: int64
		formatString: 0
		lineageTag: 087d5246-09db-4c76-8c91-822fedcadf21
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column expiry_status =
			VAR d = Delivery[expiry_days]
			RETURN
			    IF(NOT (Delivery[computed_order_status] = "Open"), BLANK(),
			    IF(ISBLANK(d), "",
			    IF(d < 0, "EXPIRED",
			    IF(d <= 30, "30 DAYS",
			    IF(d <= 60, "60 DAYS",
			    IF(d <= 90, "90 DAYS", ""))))))
		dataType: string
		lineageTag: 6d4241db-9348-42bc-bd14-89871a0e765a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column is_delivery_backed =
			IF(NOT (Delivery[computed_order_status] = "Open"), BLANK(),
			    (NOT ISBLANK(Delivery[delivery_no]) && Delivery[delivery_no] <> "") || UPPER(TRIM(Delivery[so_overall_delivery_status])) = "B")
		dataType: boolean
		lineageTag: 8fcfbbe9-9732-426f-81ad-ebddb028e639
