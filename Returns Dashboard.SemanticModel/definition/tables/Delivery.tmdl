	column resolved_expiry
		dataType: dateTime
		formatString: Long Date
		lineageTag: 4e88cfd2-1013-4191-8ca2-7c74870cf307
		summarizeBy: none
		sourceColumn: resolved_expiry

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column owner_record_idx =
			VAR buKey = UPPER(TRIM(Delivery[bu]))
			VAR regionRaw = UPPER(TRIM(Delivery[region_id]))
			VAR terrRaw = UPPER(TRIM(Delivery[territory_id]))
			VAR shipTo = UPPER(TRIM(Delivery[ship_to_no]))
			VAR soldTo = UPPER(TRIM(Delivery[sold_to]))
			VAR regionKey = IF(buKey <> "" && regionRaw <> "", buKey & "|" & regionRaw)
			VAR shipKey = IF(buKey <> "" && shipTo <> "", buKey & "|" & shipTo)
			VAR soldKey = IF(buKey <> "" && soldTo <> "", buKey & "|" & soldTo)
			VAR byRegion = IF(ISBLANK(regionKey), BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[region_lookup_key], regionKey))
			VAR byTerr = IF(terrRaw = "", BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[territory_lookup_key], terrRaw))
			VAR byShip = IF(ISBLANK(shipKey), BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[acct_lookup_key], shipKey))
			VAR bySold = IF(ISBLANK(soldKey), BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[acct_lookup_key], soldKey))
			RETURN IF(buKey = "", BLANK(), COALESCE(byRegion, byTerr, byShip, bySold))
		dataType: int64
		formatString: 0
		lineageTag: 16d039d2-bc8e-4001-92ee-e627ac3c4c47
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column owner_tier =
			VAR buKey = UPPER(TRIM(Delivery[bu]))
			VAR regionRaw = UPPER(TRIM(Delivery[region_id]))
			VAR terrRaw = UPPER(TRIM(Delivery[territory_id]))
			VAR shipTo = UPPER(TRIM(Delivery[ship_to_no]))
			VAR soldTo = UPPER(TRIM(Delivery[sold_to]))
			VAR regionKey = IF(buKey <> "" && regionRaw <> "", buKey & "|" & regionRaw)
			VAR shipKey = IF(buKey <> "" && shipTo <> "", buKey & "|" & shipTo)
			VAR soldKey = IF(buKey <> "" && soldTo <> "", buKey & "|" & soldTo)
			VAR byRegion = IF(ISBLANK(regionKey), BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[region_lookup_key], regionKey))
			VAR byTerr = IF(terrRaw = "", BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[territory_lookup_key], terrRaw))
			VAR byShip = IF(ISBLANK(shipKey), BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[acct_lookup_key], shipKey))
			VAR bySold = IF(ISBLANK(soldKey), BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[acct_lookup_key], soldKey))
			RETURN
			    IF(buKey = "", "default_no_bu",
			    IF(NOT ISBLANK(byRegion), "region",
			    IF(NOT ISBLANK(byTerr), "territory",
			    IF(NOT ISBLANK(byShip), "account_ship_to",
			    IF(NOT ISBLANK(bySold), "account_sold_to", "default_no_match")))))
		dataType: string
		lineageTag: 55a60e9b-2598-4f98-a943-85908847e7e4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column inventory_owner =
			VAR idx = Delivery[owner_record_idx]
			VAR useRep = LEFT(UPPER(TRIM(Delivery[ship_to_no])), 5) = "80000"
			VAR rep = IF(ISBLANK(idx), BLANK(), LOOKUPVALUE(OwnerAlignment[owner_rep], OwnerAlignment[src_idx], idx))
			VAR consign = IF(ISBLANK(idx), BLANK(), LOOKUPVALUE(OwnerAlignment[owner_consign], OwnerAlignment[src_idx], idx))
			VAR picked = UPPER(TRIM(IF(useRep, rep, consign)))
			RETURN IF(picked = "", "DEFAULT OWNER", picked)
		dataType: string
		lineageTag: 2390cd12-c650-4e6b-8928-55655f0e4e84
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column mv_pick =
			VAR isOpen = Delivery[computed_order_status] = "Open"
			VAR dn = Delivery[delivery_no]
			VAR sk = Delivery[sku]
			VAR bt = Delivery[batch]
			VAR ok = isOpen && NOT ISBLANK(dn) && dn <> "" && NOT ISBLANK(sk) && sk <> ""
			RETURN
			    IF(NOT isOpen, BLANK(),
			    IF(NOT ok, "none||",
			        VAR hasBatch = NOT ISBLANK(bt) && bt <> ""
			        VAR candRefSku = FILTER(Movement, Movement[reference] = dn && Movement[sku] = sk)
			        VAR candExact = FILTER(candRefSku, Movement[batch] = bt)
			        VAR useExact = hasBatch && COUNTROWS(candExact) > 0
			        VAR nAny = COUNTROWS(candRefSku)
			        VAR maxB = IF(useExact, MAXX(FILTER(candExact, Movement[movement_type] = "WHR"), Movement[posting_date]), MAXX(FILTER(candRefSku, Movement[movement_type] = "WHR"), Movement[posting_date]))
			        VAR maxD = IF(useExact, MAXX(FILTER(candExact, Movement[movement_type] = "RET"), Movement[posting_date]), MAXX(FILTER(candRefSku, Movement[movement_type] = "RET"), Movement[posting_date]))
			        VAR pickType = IF(NOT ISBLANK(maxD) && (ISBLANK(maxB) || maxD >= maxB), "RET", IF(NOT ISBLANK(maxB), "WHR", BLANK()))
			        VAR pickDate = IF(pickType = "RET", maxD, maxB)
			        VAR basis = IF(useExact, "Reference+Material+Batch", IF(nAny > 0, IF(hasBatch, "Reference+Material (batch-fallback)", "Reference+Material"), BLANK()))
			        RETURN IF(ISBLANK(basis) || ISBLANK(pickType), "none||", basis & "|" & pickType & "|" & FORMAT(pickDate, "yyyy-MM-dd"))
			    ))
		dataType: string
		isHidden
		lineageTag: 67ef21f9-8650-4504-a0b4-37d3fd00904d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column mv_type =
			VAR p = Delivery[mv_pick]
			VAR ty = IF(ISBLANK(p), "", PATHITEM(p, 2))
			RETURN IF(ty = "", BLANK(), ty)
		dataType: string
		lineageTag: 2db413e3-1da6-4ecb-be5d-ea0546e36124
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column mv_label = SWITCH(Delivery[mv_type], "WHR", "Movement by Distribution Center", "RET", "Delivery Dropped", BLANK())
		dataType: string
		lineageTag: e83ecc9d-66de-420d-8ddd-961e40f6dc58
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column mv_date =
			VAR p = Delivery[mv_pick]
			VAR s = IF(ISBLANK(p), "", PATHITEM(p, 3))
			RETURN IF(s = "", BLANK(), DATE(VALUE(LEFT(s, 4)), VALUE(MID(s, 6, 2)), VALUE(RIGHT(s, 2))))
		dataType: dateTime
		formatString: Long Date
