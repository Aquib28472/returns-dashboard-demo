/// Field return order lines with delivery details. One row per order line; the calculated columns classify each open line and pick the next action. Synthetic demo data.
table Delivery
	lineageTag: 610888c8-df4f-40da-a461-940618bfc49f

	measure 'Open Returns' = COALESCE(CALCULATE(COUNTROWS(Delivery), Delivery[is_in_scope] = TRUE()), 0)
		formatString: #,0
		displayFolder: Returns KPIs
		lineageTag: 60c75281-4f59-4986-bff6-ba94d2463ada

	measure 'Delivery-backed Open Returns' = COALESCE(CALCULATE(COUNTROWS(Delivery), Delivery[is_delivery_backed] = TRUE(), Delivery[is_in_scope] = TRUE()), 0)
		formatString: #,0
		displayFolder: Returns KPIs
		lineageTag: 7c7d4d8c-e655-4272-b6b2-430a690357f1

	measure 'Expired Items' = COALESCE(CALCULATE(COUNTROWS(Delivery), Delivery[expiry_status] = "EXPIRED", Delivery[is_in_scope] = TRUE()), 0)
		formatString: #,0
		displayFolder: Returns KPIs
		lineageTag: 967a0ec9-1810-499d-a98c-d6ad9b5dff91

	measure 'Aging Threshold Days' = 1
		formatString: 0
		displayFolder: Returns KPIs
		lineageTag: 33d2f3cf-005d-4634-b50c-6fa0031dcb5d

	measure 'Over Threshold' =
			VAR thr = [Aging Threshold Days]
			RETURN COALESCE(COUNTROWS(FILTER(Delivery, Delivery[is_in_scope] = TRUE() && Delivery[aging_days] > thr)), 0)
		formatString: #,0
		displayFolder: Returns KPIs
		lineageTag: b05bbde8-ab98-4514-be0f-93488ccb8a52

	measure 'Oldest Item (days)' = CALCULATE(MAX(Delivery[aging_days]), Delivery[is_in_scope] = TRUE())
		formatString: #,0
		displayFolder: Aging
		lineageTag: d0c38b75-c79d-404c-b135-6f17e0326fc8

	measure 'Avg Aging Days' = CALCULATE(AVERAGE(Delivery[aging_days]), Delivery[is_in_scope] = TRUE())
		formatString: 0.0
		displayFolder: Aging
		lineageTag: 3aabb993-8431-49db-8932-eb4739ec3121

	measure 'Bucket % of Open' = DIVIDE([Open Returns], CALCULATE([Open Returns], REMOVEFILTERS(Delivery[aging_bucket], Delivery[aging_bucket_order])))
		formatString: 0.0%
		displayFolder: Aging
		lineageTag: 8f684ac2-ade0-43d4-94b6-a02101889842

	measure 'Aging As Of' = MAX(Delivery[aging_asof])
		formatString: Long Date
		displayFolder: Aging
		lineageTag: 19cf837c-0c0a-4236-94da-aeb5badc94f0

	measure 'Aging Data Age (days)' = DATEDIFF([Aging As Of], TODAY(), DAY)
		formatString: 0
		displayFolder: Aging
		lineageTag: 7ce9d527-0180-4624-91da-53bb4346ba1b

	measure 'Expiring in 30 Days' = COALESCE(COUNTROWS(FILTER(Delivery, Delivery[is_in_scope] = TRUE() && Delivery[expiry_days] > 0 && Delivery[expiry_days] <= 30)), 0)
		formatString: #,0
		displayFolder: Expiry
		lineageTag: 4f229a69-a275-4c45-b91d-9ca81e61adf4

	measure 'Expiring in 31-60 Days' = COALESCE(COUNTROWS(FILTER(Delivery, Delivery[is_in_scope] = TRUE() && Delivery[expiry_days] > 30 && Delivery[expiry_days] <= 60)), 0)
		formatString: #,0
		displayFolder: Expiry
		lineageTag: cf093de5-6df2-4ed8-b3ce-5a2ac8bf1d9a

	measure 'Expiring in 61-90 Days' = COALESCE(COUNTROWS(FILTER(Delivery, Delivery[is_in_scope] = TRUE() && Delivery[expiry_days] > 60 && Delivery[expiry_days] <= 90)), 0)
		formatString: #,0
		displayFolder: Expiry
		lineageTag: 83fb90bb-5c5d-4a3d-a64c-37d944709fc6

	measure 'Open Returns (All Time)' = COALESCE(CALCULATE(COUNTROWS(Delivery), Delivery[computed_order_status] = "Open"), 0)
		formatString: #,0
		displayFolder: Returns KPIs
		lineageTag: c49c0a9f-7986-403a-8499-5cdb4d6ce7c0

	/// Orders logged on/after this date are in scope. Must equal the literal in Delivery[is_in_scope] - change both together.
	measure 'Report Start Date' = DATE(2026, 1, 1)
		formatString: Long Date
		displayFolder: Returns KPIs
		lineageTag: 35b969ac-e8b3-48b5-a63f-cb618fd28725

	measure 'Exception Count' = COALESCE(COUNTROWS(FILTER(Delivery, Delivery[is_in_scope] = TRUE() && NOT ISBLANK(Delivery[exception_issue]))), 0)
		formatString: #,0
		displayFolder: Exceptions
		lineageTag: 700a45ac-568f-460e-865f-0225a36d24da

	measure 'Critical Exceptions' = COALESCE(COUNTROWS(FILTER(Delivery, Delivery[is_in_scope] = TRUE() && Delivery[exception_severity] = "CRITICAL")), 0)
		formatString: #,0
		displayFolder: Exceptions
		lineageTag: 61af76ff-6000-4c94-828a-f98f35679666

	measure 'High Exceptions' = COALESCE(COUNTROWS(FILTER(Delivery, Delivery[is_in_scope] = TRUE() && Delivery[exception_severity] = "HIGH")), 0)
		formatString: #,0
		displayFolder: Exceptions
		lineageTag: 18743fd9-6427-4774-a7e1-b444eef4853c

	measure 'Medium Exceptions' = COALESCE(COUNTROWS(FILTER(Delivery, Delivery[is_in_scope] = TRUE() && Delivery[exception_severity] = "MEDIUM")), 0)
		formatString: #,0
		displayFolder: Exceptions
		lineageTag: e1bfa41f-bc21-4d29-a041-7c343db48803

	measure 'Top Exception Priority' = CALCULATE(MAX(Delivery[exception_priority]), Delivery[is_in_scope] = TRUE())
		formatString: 0
		displayFolder: Exceptions
		lineageTag: dd7640e4-a57d-47c0-9cf6-b6c17b96c731

	measure 'Inventory Queue Items' = COALESCE(COUNTROWS(FILTER(Delivery, Delivery[is_in_scope] = TRUE() && Delivery[action_owner] = "Inventory")), 0)
		formatString: #,0
		displayFolder: Exceptions
		lineageTag: d246aa97-7ce3-4efb-abd1-49a0a408852c

	measure 'Tracking %' =
			VAR n = [Open Returns]
			RETURN IF(n = 0, BLANK(), DIVIDE(COALESCE(COUNTROWS(FILTER(Delivery, Delivery[is_in_scope] = TRUE() && NOT(ISBLANK(Delivery[tracking])) && TRIM(Delivery[tracking]) <> "")), 0), n) * 100)
		formatString: 0.0
		displayFolder: Inventory Scoring
		lineageTag: dcebe78c-f71c-4675-a04a-098879552469

	measure 'Over Threshold %' =
			VAR n = [Open Returns]
			RETURN IF(n = 0, BLANK(), DIVIDE([Over Threshold], n) * 100)
		formatString: 0.0
		displayFolder: Inventory Scoring
		lineageTag: 574f4e01-4615-46b8-abe6-52b630491ead

	measure 'Expired %' =
			VAR n = [Open Returns]
			RETURN IF(n = 0, BLANK(), DIVIDE([Expired Items], n) * 100)
		formatString: 0.0
		displayFolder: Inventory Scoring
		lineageTag: 26ac9361-f1d8-4c6b-a758-65a1f3abe881

	measure 'Weighted Exceptions' = [Critical Exceptions] * 3 + [High Exceptions] * 2 + [Medium Exceptions]
		formatString: #,0
		displayFolder: Inventory Scoring
		lineageTag: 628045b4-78ac-472d-9c54-009bec90879c

	measure 'Weighted Exception Rate' =
			VAR n = [Open Returns]
			RETURN IF(n = 0, BLANK(), DIVIDE([Weighted Exceptions], n) * 100)
		formatString: 0.0
		displayFolder: Inventory Scoring
		lineageTag: e10ff8e6-7586-45f7-ae7f-38f93e7807a4

	measure 'Aging Score' = IF([Open Returns] = 0, BLANK(), MAX(0, 100 - [Avg Aging Days] / MAX([Aging Threshold Days], 1) * 50))
		formatString: 0.0
		displayFolder: Inventory Scoring
		lineageTag: 1be23c3d-17ba-4284-958a-79aa62e4f6b2

	measure 'Tracking Score' = [Tracking %]
		formatString: 0.0
		displayFolder: Inventory Scoring
		lineageTag: 193d3212-d357-4f27-af87-e57cfe3e353b

	measure 'Exception Score' = IF([Open Returns] = 0, BLANK(), MAX(0, 100 - [Weighted Exception Rate] * 2))
		formatString: 0.0
		displayFolder: Inventory Scoring
		lineageTag: 42238351-c4ce-49ea-a9e0-3f81a037f0fc

	measure 'Overdue Score' = IF([Open Returns] = 0, BLANK(), MAX(0, 100 - [Over Threshold %] * 2))
		formatString: 0.0
		displayFolder: Inventory Scoring
		lineageTag: 79a07d72-25ba-452a-b97b-1f57719712d6

	measure 'Expiry Score' = IF([Open Returns] = 0, BLANK(), MAX(0, 100 - [Expired %] * 3))
		formatString: 0.0
		displayFolder: Inventory Scoring
		lineageTag: ec8a400e-831d-46b6-ba41-009af166f8a2

	measure 'Inventory Score' =
			IF([Open Returns] = 0, BLANK(),
			    ROUND([Aging Score] * 0.30 + [Tracking Score] * 0.20 + [Exception Score] * 0.25 + [Overdue Score] * 0.15 + [Expiry Score] * 0.10, 1))
		formatString: 0.0
		displayFolder: Inventory Scoring
		lineageTag: 901ea133-c785-4597-a260-4dcb2c1a5c85

	measure 'To Create or Drop Delivery' = COALESCE(COUNTROWS(FILTER(Delivery, Delivery[is_in_scope] = TRUE() && (LEFT(Delivery[action_group], 1) = "1" || LEFT(Delivery[action_group], 1) = "2"))), 0)
		formatString: #,0
		displayFolder: Inventory Actions
		lineageTag: 971d6c42-b092-437c-bf30-ff442a355a12

	measure 'To Review or Chase' = COALESCE(COUNTROWS(FILTER(Delivery, Delivery[is_in_scope] = TRUE() && (LEFT(Delivery[action_group], 1) = "3" || LEFT(Delivery[action_group], 1) = "4" || LEFT(Delivery[action_group], 1) = "5" || LEFT(Delivery[action_group], 1) = "6"))), 0)
		formatString: #,0
		displayFolder: Inventory Actions
		lineageTag: 9dc40ac1-d4bc-4300-83da-8a208180e302

	measure 'Ready to Close' = COALESCE(COUNTROWS(FILTER(Delivery, Delivery[is_in_scope] = TRUE() && LEFT(Delivery[action_group], 1) = "7")), 0)
		formatString: #,0
		displayFolder: Inventory Actions
		lineageTag: 0bfac1aa-5e47-422f-8978-1e2609c5deeb

	measure 'Returns Raised' = COUNTROWS(Delivery)
		formatString: #,0
		displayFolder: Inventory Monthly
		lineageTag: ca680ffb-91fe-42cb-af30-785eb9b37141

	measure 'Closed Without Delivery' = COALESCE(COUNTROWS(FILTER(Delivery, NOT(Delivery[date] > DATE(1900,1,2)) && Delivery[computed_order_status] = "Closed")), 0)
		formatString: #,0
		displayFolder: Inventory Monthly
		lineageTag: fc80be1a-e9d4-4f18-8897-af3579b7560e

	measure 'Still Open (Cohort)' = COALESCE(COUNTROWS(FILTER(Delivery, Delivery[computed_order_status] = "Open")), 0)
		formatString: #,0
		displayFolder: Inventory Monthly
		lineageTag: 65acc9e9-024b-4d40-ae1d-6a7c02471ff5

	measure 'Avg Days to Delivery' = AVERAGEX(FILTER(Delivery, Delivery[date] > DATE(1900,1,2)), DATEDIFF(Delivery[order_date], Delivery[date], DAY))
		formatString: 0.0
		displayFolder: Inventory Monthly
		lineageTag: 33ac9b78-b0a0-4bd2-a85e-757baf6c14d4

	measure 'Created Within Threshold %' = DIVIDE(COUNTROWS(FILTER(Delivery, Delivery[date] > DATE(1900,1,2) && DATEDIFF(Delivery[order_date], Delivery[date], DAY) <= [Aging Threshold Days])), [Returns Raised] - [Closed Without Delivery])
		formatString: 0.0%
		displayFolder: Inventory Monthly
		lineageTag: 14c2b565-f7d5-4c93-80cf-07c6897a2fa1

