/// Warehouse movement events for return deliveries: return dispatched (RET) and warehouse receipt (WHR). Enriched with lot resolution and a movement status. Synthetic demo data.
table Movement
	lineageTag: 9dd1b83f-2958-484d-920c-e2f816d92fdd

	column movement_type
		dataType: string
		lineageTag: 869b9d53-a71f-423e-80fa-88cf30ab5f12
		summarizeBy: none
		sourceColumn: movement_type

		annotation SummarizationSetBy = Automatic

	column posting_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 170383a5-fbdb-4fae-b0b5-93e744ea5c13
		summarizeBy: none
		sourceColumn: posting_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column reference
		dataType: string
		lineageTag: 4d28c5bd-b5ad-488a-8aad-da581dbfa724
		summarizeBy: none
		sourceColumn: reference

