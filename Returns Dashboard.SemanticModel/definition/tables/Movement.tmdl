	column movement_status
		dataType: string
		lineageTag: bd4a5f6a-7b8c-4d9e-af1a-4b5c6d7e8f9c
		summarizeBy: none
		sourceColumn: movement_status

		annotation SummarizationSetBy = Automatic

	partition Movement = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "movement.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Renamed Columns" = Table.TransformColumnTypes(Promoted, {{"movement_type", type text}, {"reference", type text}, {"sku", type text}, {"description", type text}, {"matdoc_no", type text}, {"sales_order", type text}, {"batch", type text}, {"plant", type text}, {"product_division", type text}, {"quantity", type number}}),
				    #"Typed Posting Date" = Table.Buffer(Table.TransformColumnTypes(#"Renamed Columns", {{"posting_date", type date}})),
				
				    DeliverySlim = Table.Buffer(Table.TransformColumnTypes(Table.SelectColumns(Delivery, {"delivery_no","sku","batch","date","serial"}), {{"date", type date}})),
				    GroupedByBatch = Table.Buffer(
				        Table.Group(Table.SelectRows(DeliverySlim, each [delivery_no] <> null and [batch] <> null), {"delivery_no","sku","batch"},
				            {{"CandidatesExact", each Table.ToRecords(Table.SelectColumns(_, {"date","batch","serial"})), type list}})
				    ),
				    GroupedNoBatch = Table.Buffer(
				        Table.Group(Table.SelectRows(DeliverySlim, each [delivery_no] <> null), {"delivery_no","sku"},
				            {{"CandidatesNoBatch", each Table.ToRecords(Table.SelectColumns(_, {"date","batch","serial"})), type list},
				             {"DistinctBatchCount", each List.Count(List.Distinct(Table.Column(_, "batch"))), Int64.Type}})
				    ),
				
				    #"Merged Exact" = Table.NestedJoin(#"Typed Posting Date", {"reference","sku","batch"}, GroupedByBatch, {"delivery_no","sku","batch"}, "ExactMatch", JoinKind.LeftOuter),
				    #"Expanded Exact" = Table.ExpandTableColumn(#"Merged Exact", "ExactMatch", {"CandidatesExact"}, {"CandidatesExact"}),
				    #"Merged NoBatch" = Table.NestedJoin(#"Expanded Exact", {"reference","sku"}, GroupedNoBatch, {"delivery_no","sku"}, "NoBatchMatch", JoinKind.LeftOuter),
				    #"Expanded NoBatch" = Table.ExpandTableColumn(#"Merged NoBatch", "NoBatchMatch", {"CandidatesNoBatch","DistinctBatchCount"}, {"CandidatesNoBatch","DistinctBatchCount"}),
				
				    PickClosest = (candidates as nullable list, postingDate as nullable date) as record =>
				        let
				            candList = if candidates = null then {} else candidates,
				            validCandidates = List.Select(candList, each [date] <> null),
				            pastOrEqual = if postingDate = null then {} else List.Select(validCandidates, each [date] <= postingDate),
				            pool = if List.Count(pastOrEqual) > 0 then pastOrEqual else validCandidates,
				            maxDate = if List.Count(pool) > 0 then List.Max(List.Transform(pool, each [date])) else null,
				            chosen = if maxDate = null then null else List.First(List.Select(pool, each [date] = maxDate))
				        in
				            if chosen = null then [batch=null, serial=null, lot_resolved=false]
				            else [batch=chosen[batch], serial=chosen[serial], lot_resolved=true],
				
				    #"Added Resolution" = Table.AddColumn(#"Expanded NoBatch", "Resolution", each
				        let
				            useExact = [batch] <> null and [CandidatesExact] <> null and List.Count([CandidatesExact]) > 0,
				            useNoBatchAmbiguousOk = [batch] <> null and [CandidatesNoBatch] <> null and [DistinctBatchCount] <> null and [DistinctBatchCount] <= 1,
				            useNoBatchDirect = [batch] = null and [CandidatesNoBatch] <> null
				        in
				            if useExact then PickClosest([CandidatesExact], [posting_date])
				            else if useNoBatchAmbiguousOk then PickClosest([CandidatesNoBatch], [posting_date])
				            else if useNoBatchDirect then PickClosest([CandidatesNoBatch], [posting_date])
				            else [batch=null, serial=null, lot_resolved=false]),
				    #"Expanded Resolution" = Table.ExpandRecordColumn(#"Added Resolution", "Resolution", {"batch","serial","lot_resolved"}, {"resolved_batch","resolved_serial","lot_resolved"}),
				    #"Removed Join Helpers" = Table.RemoveColumns(#"Expanded Resolution", {"CandidatesExact","CandidatesNoBatch","DistinctBatchCount"}),
				
				    KeysWhr = Table.Buffer(Table.AddColumn(Table.Distinct(Table.SelectColumns(Table.SelectRows(#"Typed Posting Date", each [movement_type] = "WHR"), {"reference","sku","batch"})), "has_whr", each true, type logical)),
				    #"Merged HasWhr" = Table.NestedJoin(#"Removed Join Helpers", {"reference","sku","batch"}, KeysWhr, {"reference","sku","batch"}, "HasWhrMatch", JoinKind.LeftOuter),
				    #"Added HasWhr" = Table.ExpandTableColumn(#"Merged HasWhr", "HasWhrMatch", {"has_whr"}, {"has_whr"}),
				
				    #"Added Movement Status" = Table.AddColumn(#"Added HasWhr", "movement_status", each
				        if [movement_type] = "RET" then (if [has_whr] = true then "Dropped-After-Inbound" else "Dropped-Never-Inbounded")
				        else if [movement_type] = "WHR" then "Inbounded"
				        else "No Movement",
				        type text),
				    #"Removed HasWhr Col" = Table.RemoveColumns(#"Added Movement Status", {"has_whr"})
				in
				    #"Removed HasWhr Col"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

