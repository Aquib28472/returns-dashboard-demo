	column batch
		dataType: string
		lineageTag: 5053bbc7-1d9e-41ff-b068-dafd0655163f
		summarizeBy: none
		sourceColumn: batch

		annotation SummarizationSetBy = Automatic

	column plant
		dataType: string
		lineageTag: fec6ef1b-bcf8-43ec-8847-9d3733aab485
		summarizeBy: none
		sourceColumn: plant

